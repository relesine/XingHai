# ============================================================
# XingHai 环境变量示例（复制为 .env 后按需修改，.env 不入库）
# ============================================================

# ---------- 运行环境 ----------
SPRING_PROFILES_ACTIVE=dev

# ---------- 数据库 ----------
DB_URL=jdbc:mysql://localhost:3306/xinghai?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
# 本地默认口令见项目完整文档第 13 节；对外部署必须修改
DB_PASSWORD=change-me

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 安全 ----------
# 生产环境必须替换为不少于 32 字节的随机字符串
JWT_SECRET=change-me-to-a-random-secret-with-at-least-32-bytes
JWT_EXPIRE=604800000

# ---------- 上传与跨域 ----------
UPLOAD_DIR=F:/AI_full-stack_project/XingHai/uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---------- 前端（构建时注入） ----------
VITE_USER_URL=http://localhost:5173
VITE_CREATOR_URL=http://localhost:5174
VITE_ADMIN_URL=http://localhost:5175
